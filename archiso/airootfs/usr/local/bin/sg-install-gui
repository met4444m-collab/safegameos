QPushButton:disabled {{ color: #4a5570; border-color: #182238; }}
QPushButton#primary {{ background: {GREEN}; color: #06280f; border: none; padding: 12px 28px; font-size: 15px; }}
QPushButton#primary:hover {{ background: #4adeb8; }}
