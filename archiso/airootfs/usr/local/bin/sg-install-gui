        lay.addWidget(h)
        self.text = QLabel("")
        self.text.setObjectName("sub")
        lay.addWidget(self.text)
        lay.addStretch()
        self.go = QPushButton("Начать установку")
        self.go.setObjectName("danger")
        self.go.clicked.connect(win.start_install)
        lay.addWidget(self.go)


