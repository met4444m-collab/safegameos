#!/usr/bin/env bash
# safegamingOS — разблокировать ранее заблокированный URL (ложное срабатывание).
# Usage: sudo sg-unblock-url URL
set -uo pipefail

source /usr/local/lib/sg-rooms/lib.sh
sg_require sqlite3
[[ $EUID -eq 0 ]] || { echo "error: запустите от root: sudo sg-unblock-url URL" >&2; exit 1; }
[[ $# -ge 1 ]] || { echo "usage: sg-unblock-url URL" >&2; exit 1; }

sg_ensure_db
sg_unblock_url "$1"
exit 0
