class DonePage(Page):
    def __init__(self, win):
        super().__init__(win)
        lay = QVBoxLayout(self)
        lay.addStretch()
        t = QLabel("✅ Установка завершена!")
        t.setObjectName("title")
        t.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lay.addWidget(t)
        s = QLabel(
            "safegamingOS установлена на диск.\n\n"
            "1. Выключите виртуалку (или ПК)\n"
            "2. Отключите установочный ISO / выньте флешку\n"
            "3. Включите снова — увидите DVD-логотип и рабочий стол\n\n"
            "Войдите созданным пользователем — комнаты, SafeGuard и ярлыки уже на месте.")
        s.setObjectName("sub")
        s.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lay.addWidget(s)
        lay.addStretch()
        btns = QHBoxLayout()
        close = QPushButton("Закрыть")
        close.clicked.connect(win.close)
        reboot = QPushButton("Перезагрузить сейчас")
        reboot.setObjectName("primary")
        reboot.clicked.connect(win.reboot_now)
        btns.addWidget(close)
        btns.addStretch()
        btns.addWidget(reboot)
        lay.addLayout(btns)


class ErrorPage(Page):
    def __init__(self, win):
        super().__init__(win)
        lay = QVBoxLayout(self)
        t = QLabel("❌ Установка прервалась")
        t.setObjectName("title")
        t.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lay.addWidget(t)
        self.text = QLabel("")
        self.text.setObjectName("warn")
        self.text.setWordWrap(True)
        lay.addWidget(self.text)
        self.out = QPlainTextEdit()
        self.out.setReadOnly(True)
        lay.addWidget(self.out, 1)
        retry = QPushButton("Начать заново")
        retry.clicked.connect(win.restart_wizard)
        lay.addWidget(retry)


class MainWin(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(f"Установка {APP}")
        self.resize(820, 640)

        root = QWidget()
        outer = QVBoxLayout(root)
        header = QHBoxLayout()
        brand = QLabel(APP)
        brand.setObjectName("title")
        brand.setStyleSheet(f"font-size: 20px; color: {GREEN};")
        header.addWidget(brand)
        header.addStretch()
        self.step_label = QLabel("")
        self.step_label.setObjectName("step")
        header.addWidget(self.step_label)
        outer.addLayout(header)

        self.stack = QStackedWidget()
        outer.addWidget(self.stack, 1)

        nav = QHBoxLayout()
        self.back_btn = QPushButton("← Назад")
        self.back_btn.clicked.connect(self.go_back)
        nav.addWidget(self.back_btn)
        nav.addStretch()
        self.next_btn = QPushButton("Далее →")
        self.next_btn.setObjectName("primary")
        self.next_btn.clicked.connect(self.try_next)
        nav.addWidget(self.next_btn)
        outer.addLayout(nav)

        self.setCentralWidget(root)

        self.pages = [
            WelcomePage(self), DiskPage(self),
            AccountPage(self), SummaryPage(self),
            ProgressPage(self), DonePage(self), ErrorPage(self),
        ]
        for p in self.pages:
            self.stack.addWidget(p)
        self.idx = 0
        self.proc = None
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.poll)
        self.show_page(0)

    # ---------------------------------------------------------------
    def show_page(self, i):
        self.idx = i
        self.stack.setCurrentIndex(i)
        self.back_btn.setEnabled(i not in (0, 4, 5, 6))
        nxt = i < 3
        self.next_btn.setVisible(nxt)
        if i == 1:
            self.next_btn.setEnabled(False)
            self.pages[1].confirm.setChecked(False)
            self.pages[1]._check()
        if i == 2:
            self.next_btn.setEnabled(True)
        if i == 3:
            self.next_btn.setVisible(False)
        steps = ["Добро пожаловать", "Выбор диска", "Учётная запись", "Проверка", "Установка"]
        self.step_label.setText(f"ШАГ {i + 1} ИЗ 5 — {steps[i].upper()}" if i < 5 else "")

    def try_next(self):
        if self.idx == 1:
            if self.pages[1].selected() is None:
                QMessageBox.information(self, APP, "Выберите диск из списка.")
                return
            if not self.pages[1].confirm.isChecked():
                QMessageBox.warning(self, APP, "Подтвердите, что диск будет стёрт.")
                return
        if self.idx == 2:
            if not self.pages[2].validate():
                return
        self.go_next()

    def go_next(self):
        if self.idx == 2:
            disk = self.pages[1].selected()
            a = self.pages[2]
            s = self.pages[3]
            s.text.setText(
                f"Диск:              {disk}  (будет полностью стёрт)\n"
                f"Компьютер:   {a.host.text().strip()}\n"
                f"Пользователь:  {a.user.text().strip()}\n"
                f"Подкачка:      {a.swap.value()} ГБ\n"
                f"Windows-игры: {'да (Wine + Steam + Lutris)' if a.wine.isChecked() else 'нет'}")
            self.show_page(3)
        else:
            self.show_page(self.idx + 1)

    def go_back(self):
        self.show_page(max(0, self.idx - 1))

    def restart_wizard(self):
        self.pages[1].reload()
        self.show_page(0)

    def reboot_now(self):
        """Перезагрузить из live-системы (pkexec sg-reboot — wheel без пароля)."""
        try:
            subprocess.Popen(["pkexec", "/usr/local/bin/sg-reboot"], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            QMessageBox.warning(self, APP, "Не удалось перезагрузить автоматически — перезагрузите вручную.")

    # ---------------------------------------------------------------
    def start_install(self):
        a = self.pages[2]
        disk = self.pages[1].selected()
        # shell-quote every value: PASS is free-form and must survive the
        # strict KEY=value parser in sg-install-run unchanged (quotes, $, ;).
        # Формат — одинарные кавычки с '\'' для кавычки внутри (как shell_quote
        # в sg-install) — sg-install-run разбирает его без eval.
        def shq(s):
            return "'" + s.replace("'", "'\\''") + "'"
        q = shq
        cfg = (
            f"DISK={q(disk)}\n"
            f"HOSTNAME={q(a.host.text().strip())}\n"
            f"USERNAME={q(a.user.text().strip())}\n"
            f"PASS={q(a.pass1.text())}\n"
            f"SWAP_GB={q(str(a.swap.value()))}\n"
            f"WINE={q('1' if a.wine.isChecked() else '0')}\n"
        )
        try:
            conf = make_conf(cfg)
        except OSError as e:
            QMessageBox.critical(self, APP, f"не удалось записать конфиг: {e}")
            return
        try:
            self.proc = subprocess.Popen(
                ["pkexec", "/usr/local/bin/sg-install-run", conf],
                start_new_session=True,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            QMessageBox.critical(self, APP, f"не удалось запустить установку: {e}")
            return
        self.pages[4].out.clear()
        self.pages[4].bar.setValue(0)
        self.pages[4].status.setText("Запуск установщика…")
        self.show_page(4)
        self.offset = 0
        self.timer.start(500)

    def poll(self):
        try:
            with open(LOG, "r", encoding="utf-8", errors="replace") as f:
                f.seek(self.offset)
                data = f.read()
                self.offset = f.tell()
                if self.offset < 0:
                    self.offset = 0
        except OSError:
            return
        if not data:
            # file was truncated/recreated
            try:
                if os.path.getsize(LOG) < self.offset:
                    self.offset = 0
            except OSError:
                return
            return
        out = self.pages[4].out
        out.moveCursor(out.textCursor().MoveOperation.End)
        for line in data.splitlines():
            line = line.rstrip()
            if not line:
                continue
            if line.startswith("PROGRESS:"):
                try:
                    _, rest = line.split("|", 1)
                    pct = int(line.split("|", 1)[0].split(":", 1)[1])
                except (ValueError, IndexError):
                    continue
                self.pages[4].bar.setValue(pct)
                self.pages[4].status.setText(rest)
            elif line.startswith("ERROR|"):
                self.finish_error(line.split("|", 1)[1])
                return
            elif line.startswith("DONE|"):
                self.timer.stop()
                self.show_page(5)
                return
            else:
                out.appendPlainText(line)
        # process exited without DONE/ERROR?
        if self.proc is not None and self.proc.poll() is not None and self.timer.isActive():
            self.timer.stop()
            if self.pages[4].bar.value() < 100:
                empty = True
                try:
                    empty = os.path.getsize(LOG) == 0
                except OSError:
                    pass
                if empty:
                    self.finish_error(
                        "Установщик не запустился (пустой лог).\n\n"
                        "Обычно это polkit/pkexec: пользователь должен быть в группе wheel "
                        "(в live-системе это live). Попробуйте запустить установку из "
                        "терминала: sudo sg-install")
                else:
                    self.finish_error("установщик завершился неожиданно (см. лог ниже)")

    def finish_error(self, msg):
        self.timer.stop()
        p = self.pages[6]
        p.text.setText(msg)
        try:
            with open(LOG, "r", encoding="utf-8", errors="replace") as f:
                p.out.setPlainText(f.read()[-20000:])
        except OSError:
            p.out.setPlainText("(лог недоступен)")
        self.show_page(6)


def main():
    app = QApplication(sys.argv)
    app.setStyle("Fusion")
    app.setStyleSheet(STYLE)
    w = MainWin()
    w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
