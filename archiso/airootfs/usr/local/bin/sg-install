#!/usr/bin/env bash
# safegamingOS — install the OS to disk.
#
# Preferred path: graphical master (sg-install-gui) when a desktop session is
# available — double-click "Установить safegamingOS" on the live desktop.
# TTY fallback: this dialog-driven frontend. Both collect the same options
# (disk, user, password, swap, Wine) and hand off to the root helper
# sg-install-run, which does the real install: GPT partitioning, formatting,
# pacstrap, chroot configuration, branding, SafeGuard.
#
# No Python, no archinstall — its JSON config schema drifts between versions
# and used to die with a Python traceback mid-install.
set -uo pipefail

# If a graphical session is available, prefer the Windows-10-style GUI installer
# (runs as the desktop user, does the privileged work via pkexec sg-install-run).
if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v sg-install-gui >/dev/null 2>&1; then
  exec sg-install-gui "$@"
fi

TMPCONF=/tmp/sg-install.conf
LOG=/tmp/sg-install.log
trap 'rm -f "$TMPCONF"' EXIT

# ---------------------------------------------------------------------------
banner() {
  clear
  echo "=============================================="
  echo "  safegamingOS 0.9.4 — установка на диск"
  echo "=============================================="
  echo
}

# ---------------------------------------------------------------------------
# checks
for c in dialog lsblk sg-install-run; do
  command -v "$c" >/dev/null 2>&1 || { echo "error: not found: $c" >&2; exit 1; }
done
[[ $EUID -eq 0 ]] || { echo "error: запустите от root: sudo sg-install" >&2; exit 1; }

banner

# ---------------------------------------------------------------------------
# pick target disk
mapfile -t DISKS < <(lsblk -dno PATH,TYPE | awk '$2=="disk"{print $1}')
[[ ${#DISKS[@]} -gt 0 ]] || { echo "error: диски не найдены" >&2; exit 1; }

items=()
for d in "${DISKS[@]}"; do
  size=$(lsblk -dno SIZE "$d" 2>/dev/null || echo "?")
  items+=("$d" "$size")
done

DISK=$(dialog --stdout --backtitle "safegamingOS installer" \
  --menu "Выберите диск для установки. ВНИМАНИЕ: диск будет ПОЛНОСТЬЮ стёрт!" \
  0 0 0 "${items[@]}") || { banner; echo "Отменено."; exit 1; }

# ---------------------------------------------------------------------------
# user account
USERNAME=$(dialog --stdout --backtitle "safegamingOS installer" \
  --inputbox "Имя пользователя:" 0 0 "sg") || { banner; echo "Отменено."; exit 1; }
[[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]{2,31}$ ]] \
  || { banner; echo "error: недопустимое имя пользователя (3–32 символа: a-z, 0-9, _, -)" >&2; exit 1; }

PASS=$(dialog --stdout --backtitle "safegamingOS installer" \
  --passwordbox "Пароль пользователя:" 0 0) || { banner; echo "Отменено."; exit 1; }
PASS2=$(dialog --stdout --backtitle "safegamingOS installer" \
  --passwordbox "Повторите пароль:" 0 0) || { banner; echo "Отменено."; exit 1; }
if [[ -z "$PASS" || "$PASS" != "$PASS2" ]]; then
  banner; echo "error: пароль пустой или не совпадает" >&2; exit 1
fi

SWAP_GB=$(dialog --stdout --backtitle "safegamingOS installer" \
  --inputbox "Файл подкачки, ГБ (0 = без swap):" 0 0 "16") || { banner; echo "Отменено."; exit 1; }
[[ "$SWAP_GB" =~ ^[0-9]+$ ]] || { banner; echo "error: неверный размер подкачки" >&2; exit 1; }

if dialog --stdout --backtitle "safegamingOS installer" \
  --yesno "Установить Windows-игры (Wine + Steam + Lutris, ~2–3 ГБ, multilib)?\n\nДля Minecraft/Роблокса/OBS не обязательно — можно поставить позже:\n  sudo pacman -S wine steam lutris" 0 0; then
  WINE=1
else
  WINE=0
fi

dialog --stdout --backtitle "safegamingOS installer" \
  --yesno "Установить safegamingOS на диск\n$DISK\n\nПользователь: $USERNAME\nПодкачка: ${SWAP_GB} ГБ\nWindows-игры: $([ "$WINE" = "1" ] && echo да || echo нет)\n\nВСЕ ДАННЫЕ НА ДИСКЕ БУДУТ УДАЛЕНЫ.\nПродолжить?" 0 0 \
  || { banner; echo "Отменено."; exit 1; }

# ---------------------------------------------------------------------------
# write config (shell-quoted values so any special chars in the password survive)
{
  printf 'DISK=%s\n'    "$(printf '%q' "$DISK")"
  printf 'HOSTNAME=%s\n' "$(printf '%q' "safegamingos")"
  printf 'USERNAME=%s\n' "$(printf '%q' "$USERNAME")"
  printf 'PASS=%s\n'    "$(printf '%q' "$PASS")"
  printf 'SWAP_GB=%s\n' "$(printf '%q' "$SWAP_GB")"
  printf 'WINE=%s\n'    "$(printf '%q' "$WINE")"
} > "$TMPCONF"
chmod 600 "$TMPCONF"

# ---------------------------------------------------------------------------
banner
echo "==> Установка на $DISK ..."
echo "    Разметка → форматирование → скачивание пакетов (10–25 мин) → настройка."
echo "    Не выключайте компьютер и не закрывайте окно."
echo

sg-install-run "$TMPCONF" &
pid=$!
# показываем ход установки (строки PROGRESS: превращаются в обычный текст)
tail -n +1 -f --pid="$pid" "$LOG" 2>/dev/null | sed 's/^PROGRESS:[0-9]*|//'
wait "$pid"
rc=$?

echo
if [[ ${rc} -eq 0 ]] && grep -q '^DONE|' "$LOG" 2>/dev/null; then
  echo "=============================================="
  echo "  Установка safegamingOS завершена!"
  echo "  Отключите ISO/флешку и перезагрузите: reboot"
  echo "=============================================="
  exit 0
else
  echo "!! Установка прервалась (код ${rc}). Последние строки лога:" >&2
  tail -n 25 "$LOG" >&2
  exit 1
fi
