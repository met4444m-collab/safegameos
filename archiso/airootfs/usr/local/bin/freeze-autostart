#!/usr/bin/env bash
# freeze-autostart — защита автозагрузки от скрытых добавлений
#
# Мониторит автозагрузочные директории и блокирует попытки
# приложений добавить себя без ведома пользователя.
#
# freeze-autostart protect   — включить защиту
# freeze-autostart unprotect — выключить защиту
# freeze-autostart scan      — показать что в автозагрузке
# freeze-autostart clean     — удалить неразрешённые автозагрузки

set -euo pipefail

AUTOSTART_DIRS=(
    "/etc/xdg/autostart"
    "/home/*/.config/autostart"
)
LOCK_FILE="/etc/freeze-bg/autostart.lock"
LOG="/var/log/freeze-bg.log"
ALLOWED_FILE="/etc/freeze-bg/autostart-allowed.conf"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

die()  { echo -e "${RED}✗ $*${NC}" >&2; exit 1; }
info() { echo -e "${CYAN}→${NC} $*"; }
ok()   { echo -e "${GREEN}✓${NC} $*"; }
warn() { echo -e "${YELLOW}!${NC} $*"; }

# --- Загрузка списка разрешённых автозагрузок ---
load_allowed() {
    local -a allowed=()
    if [[ -f "$ALLOWED_FILE" ]]; then
        while IFS= read -r line; do
            [[ "$line" =~ ^[[:space:]]*# ]] && continue
            [[ -z "${line// }" ]] && continue
            allowed+=("$line")
        done < "$ALLOWED_FILE"
    fi
    
    # системные автозагрузки (KDE, безопасность) всегда разрешены
    local system_allowed=(
        "org.kde.plasma-welcome.desktop"
        "sg-wallpaper.desktop"
        "org.kde.plasmashell.desktop"
        "org.kde.kwalletd.desktop"
    )
    
    for s in "${system_allowed[@]}"; do
        allowed+=("$s")
    done
    
    echo "${allowed[@]}"
}

is_autostart_allowed() {
    local desktop_file="$1"
    local basename_f=$(basename "$desktop_file")
    local allowed_list
    allowed_list=($(load_allowed))
    
    for allowed in "${allowed_list[@]}"; do
        if [[ "$basename_f" == "$allowed" ]]; then
            return 0
        fi
    done
    return 1
}

# --- Защита: установить inotify watchers на автозагрузочные директории ---
cmd_protect() {
    [[ $EUID -eq 0 ]] || die "нужен root: sudo freeze-autostart protect"
    
    # проверяем inotifywait
    if ! command -v inotifywait &>/dev/null; then
        info "Устанавливаю inotify-tools..."
        pacman -S --noconfirm inotify-tools 2>/dev/null || true
    fi
    
    mkdir -p "$(dirname "$LOCK_FILE")"
    
    echo "$(date '+%Y-%m-%d %H:%M:%S') AUTOSTART_PROTECT_ON" >> "$LOG"
    
    info "Защита автозагрузки включена"
    echo "  Мониторю директории:"
    for dir in "${AUTOSTART_DIRS[@]}"; do
        for d in $dir; do
            [[ -d "$d" ]] && echo "    $d"
        done
    done
    echo
    echo "  Разрешённые файлы:"
    local allowed_list
    allowed_list=($(load_allowed))
    for a in "${allowed_list[@]}"; do
        echo "    ✓ $a"
    done
    echo
    echo "  Для мониторинга в реальном времени запусти:"
    echo "    sudo freeze-autostart watch"
}

# --- Мониторинг в реальном времени ---
cmd_watch() {
    [[ $EUID -eq 0 ]] || die "нужен root: sudo freeze-autostart watch"
    
    info "Мониторинг автозагрузки... (Ctrl+C для остановки)"
    
    local dirs_to_watch=()
    for pattern in "${AUTOSTART_DIRS[@]}"; do
        for dir in $pattern; do
            [[ -d "$dir" ]] && dirs_to_watch+=("$dir")
        done
    done
    
    if [[ ${#dirs_to_watch[@]} -eq 0 ]]; then
        die "нет автозагрузочных директорий"
    fi
    
    inotifywait -m -e create -e modify -e moved_to "${dirs_to_watch[@]}" 2>/dev/null | while read -r dir event file; do
        local fullpath="${dir}${file}"
        
        if [[ "$file" == *.desktop ]]; then
            if ! is_autostart_allowed "$fullpath"; then
                warn "НЕЗАКОННАЯ автозагрузка: $file в $dir"
                
                # читаем что там
                local app_name=$(grep -m1 "^Name=" "$fullpath" 2>/dev/null | cut -d= -f2)
                [[ -z "$app_name" ]] && app_name="$file"
                
                warn "Приложение: $app_name"
                
                # блокируем
                local lockdir="/etc/freeze-bg/locked"
                mkdir -p "$lockdir"
                cp "$fullpath" "$lockdir/${file}.locked" 2>/dev/null || true
                
                # заменяем на заглушку
                cat > "$fullpath" << DESKTOP_EOF
[Desktop Entry]
Type=Application
Name=$app_name
Comment=Заблокировано freeze-autostart — неразрешённая автозагрузка
Hidden=true
NoDisplay=true
X-GNOME-Autostart-enabled=false
DESKTOP_EOF
                chattr +i "$fullpath" 2>/dev/null || true
                
                echo "$(date '+%Y-%m-%d %H:%M:%S') AUTOSTART_BLOCKED file=$file app=$app_name dir=$dir" >> "$LOG"
                ok "Заблокировано: $app_name"
            fi
        fi
    done
}

# --- Показать что в автозагрузке ---
cmd_scan() {
    echo -e "${CYAN}=== Автозагрузка ===${NC}"
    echo
    
    for pattern in "${AUTOSTART_DIRS[@]}"; do
        for dir in $pattern; do
            [[ -d "$dir" ]] || continue
            echo -e "${YELLOW}$dir:${NC}"
            for f in "$dir"/*.desktop; do
                [[ -f "$f" ]] || continue
                local name=$(grep -m1 "^Name=" "$f" 2>/dev/null | cut -d= -f2)
                [[ -z "$name" ]] && name=$(basename "$f")
                
                local hidden=$(grep -m1 "^Hidden=" "$f" 2>/dev/null | cut -d= -f2)
                local nodisplay=$(grep -m1 "^NoDisplay=" "$f" 2>/dev/null | cut -d= -f2)
                
                if [[ "$hidden" == "true" ]] || [[ "$nodisplay" == "true" ]]; then
                    echo -e "  ${RED}🔒${NC} $name (скрыта/отключена)"
                else
                    echo -e "  ${GREEN}✓${NC} $name"
                fi
            done
            echo
        done
    done
}

# --- Удалить неразрешённые автозагрузки ---
cmd_clean() {
    [[ $EUID -eq 0 ]] || die "нужен root: sudo freeze-autostart clean"
    
    local count=0
    for pattern in "${AUTOSTART_DIRS[@]}"; do
        for dir in $pattern; do
            [[ -d "$dir" ]] || continue
            for f in "$dir"/*.desktop; do
                [[ -f "$f" ]] || continue
                
                if ! is_autostart_allowed "$f"; then
                    local name=$(basename "$f")
                    warn "Удаляю неразрешённую автозагрузку: $name"
                    rm -f "$f"
                    ((count++))
                fi
            done
        done
    done
    
    ok "Удалено неразрешённых автозагрузок: $count"
}

# --- Главное ---
case "${1:-help}" in
    protect)   cmd_protect ;;
    unprotect) 
        [[ $EUID -eq 0 ]] || die "нужен root"
        chattr -R -i /etc/xdg/autostart/*.desktop 2>/dev/null || true
        for dir in /home/*/.config/autostart; do
            chattr -R -i "$dir"/*.desktop 2>/dev/null || true
        done
        ok "Защита снята"
        ;;
    watch)     cmd_watch ;;
    scan)      cmd_scan ;;
    clean)     cmd_clean ;;
    help|--help|-h)
        echo "freeze-autostart — защита автозагрузки"
        echo
        echo "Команды:"
        echo "  protect   — включить защиту"
        echo "  unprotect — выключить защиту"
        echo "  watch     — мониторинг в реальном времени"
        echo "  scan      — показать автозагрузку"
        echo "  clean     — удалить неразрешённые автозагрузки"
        ;;
    *)
        die "неизвестная команда: $1"
        ;;
esac
