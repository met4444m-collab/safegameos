def list_disks():
    """Return list of real disks: {path, size, model}."""
    out = subprocess.run(
        ["lsblk", "-dno", "PATH,SIZE,MODEL", "-e", "7,11"],
        capture_output=True, text=True).stdout
    disks = []
    for line in out.strip().splitlines():
        parts = line.split(None, 2)
        if len(parts) >= 2:
            disks.append({
                "path": parts[0],
                "size": parts[1],
                "model": parts[2] if len(parts) > 2 else "",
            })
    return disks


class Page(QWidget):
    def __init__(self, win):
        super().__init__()
        self.win = win


class WelcomePage(Page):
    def __init__(self, win):
        super().__init__(win)
        lay = QVBoxLayout(self)
        lay.addStretch()
        t = QLabel(APP)
        t.setObjectName("title")
        t.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lay.addWidget(t)
        s = QLabel("Безопасная ОС для игр и стримов — изоляция приложений в комнатах")
        s.setObjectName("sub")
        s.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lay.addWidget(s)
        lay.addSpacing(28)
        info = QLabel(
            "Этот мастер установит safegamingOS на ваш диск.\n\n"
            "После установки всё готово из коробки:\n"
            "• Комнаты изоляции (браузер / игры / стрим) — по одному клику с рабочего стола\n"
            "• SafeGuard — антивирус, лимиты CPU/RAM, карантин, блокировка вирусных ссылок\n"
            "• Загрузочная DVD-анимация, 16 ГБ swapfile, всё брендировано\n\n"
            "Требования: диск от 8 ГБ, интернет (скачиваются пакеты), ~15–30 минут времени.")
        info.setObjectName("h")
        info.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lay.addWidget(info)
        lay.addStretch()


class DiskPage(Page):
    def __init__(self, win):
        super().__init__(win)
        lay = QVBoxLayout(self)
        h = QLabel("Выберите диск для установки")
        h.setObjectName("h")
        lay.addWidget(h)
        warn = QLabel("⚠️ ВНИМАНИЕ: весь выбранный диск будет ПОЛНОСТЬЮ стёрт и отформатирован!")
        warn.setObjectName("warn")
        lay.addWidget(warn)
        self.list = QListWidget()
        lay.addWidget(self.list, 1)
        self.confirm = QCheckBox("Я понимаю: все данные на этом диске будут безвозвратно удалены")
        lay.addWidget(self.confirm)
        self.reload()
        self.list.itemSelectionChanged.connect(lambda: self.win.next_btn.setEnabled(False))
        self.confirm.toggled.connect(self._check)
        self.list.itemDoubleClicked.connect(lambda _i: self.win.try_next())

    def _check(self):
        self.win.next_btn.setEnabled(self.confirm.isChecked() and self.list.currentItem() is not None)

    def reload(self):
        self.list.clear()
        for d in list_disks():
            label = f"{d['path']}   {d['size']}" + (f"   ({d['model']})" if d["model"] else "")
            it = QListWidgetItem(label)
            it.setData(Qt.ItemDataRole.UserRole, d["path"])
            self.list.addItem(it)

    def selected(self):
        it = self.list.currentItem()
        return it.data(Qt.ItemDataRole.UserRole) if it else None


class AccountPage(Page):
    def __init__(self, win):
        super().__init__(win)
        lay = QVBoxLayout(self)
        h = QLabel("Создание учётной записи")
        h.setObjectName("h")
        lay.addWidget(h)

        def row(label, widget):
            r = QHBoxLayout()
            l = QLabel(label)
            l.setFixedWidth(180)
            r.addWidget(l)
            r.addWidget(widget, 1)
            lay.addLayout(r)

        self.host = QLineEdit("safegamingos")
        row("Имя компьютера:", self.host)
        self.user = QLineEdit()
        self.user.setPlaceholderText("например: player")
        row("Имя пользователя:", self.user)
        self.pass1 = QLineEdit()
        self.pass1.setEchoMode(QLineEdit.EchoMode.Password)
        row("Пароль:", self.pass1)
        self.pass2 = QLineEdit()
        self.pass2.setEchoMode(QLineEdit.EchoMode.Password)
        row("Повторите пароль:", self.pass2)
        self.swap = QSpinBox()
        self.swap.setRange(0, 64)
        self.swap.setValue(16)
        self.swap.setSuffix(" ГБ")
        row("Файл подкачки:", self.swap)
        self.wine = QCheckBox("Установить Windows-игры: Wine + Steam + Lutris (~2–3 ГБ, multilib)")
        lay.addWidget(self.wine)
        self.err = QLabel("")
        self.err.setObjectName("warn")
        lay.addWidget(self.err)
        lay.addStretch()

    def validate(self):
        u = self.user.text().strip()
        p1 = self.pass1.text()
        p2 = self.pass2.text()
        h = self.host.text().strip()
        if not re.match(r"^[a-z_][a-z0-9_-]{2,31}$", u):
            self.err.setText("Имя пользователя: 3–32 символа, латиница в нижнем регистре (a-z, 0-9, _, -)")
            return False
        if not re.match(r"^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$", h):
            self.err.setText("Имя компьютера: латиница, без пробелов")
            return False
        if len(p1) < 1 or p1 != p2:
            self.err.setText("Пароль пустой или не совпадает")
            return False
        self.err.setText("")
        return True


class SummaryPage(Page):
    def __init__(self, win):
        super().__init__(win)
        lay = QVBoxLayout(self)
        h = QLabel("Проверьте параметры установки")
